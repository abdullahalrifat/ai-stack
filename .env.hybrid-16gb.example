# Recommended OptiPlex 7040 16 GB CPU-only profile.
# Local inference is the default; optional cheap/frontier cloud routes are used
# only when the deterministic router escalates.

INFERENCE_MODE=hybrid

# Keep only small models on the CPU host.
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_MODELS=qwen3:4b-instruct qwen3:8b nomic-embed-text

# Optional remote endpoint. Leave blank to remain fully local.
HF_MODEL=
HF_CODER_MODEL=
HF_REASONING_MODEL=
HF_VISION_MODEL=
HF_INFERENCE_BASE_URL=
HF_API_KEY=

# Provider-neutral aliases.
DEFAULT_MODEL=coder
FAST_MODEL=quick
ROUTER_MODEL=quick
ROUTER_ESCALATION_MODEL=coder
RESEARCH_MODEL=quick
FINANCE_MODEL=coder
AGENT_REASONING_MODEL=reasoning
CHANGE_REVIEW_MODEL=reasoning
CHANGE_REVIEW_MODEL_ENABLED=true

# Cost-aware routing: local first, then configured cheap cloud, then frontier.
# Values are comma-separated model ids exposed by LiteLLM.
JARVIS_LOCAL_MODELS=quick,coder,qwen3-8b
JARVIS_CHEAP_MODELS=
JARVIS_FRONTIER_MODELS=

# The OptiPlex is the durable control plane, not a parallel inference box.
MAX_CONCURRENT_AGENT_RUNS=1
MAX_CONCURRENT_LLM_CALLS=1
MAX_PARALLEL_EXPERTS=1
EXPERT_DISPATCH_ENABLED=false

CONTEXT_TOKEN_LIMIT=16384
CONTEXT_OUTPUT_RESERVE_TOKENS=3072
OPENAI_INPUT_MAX_CHARS=10000
MAX_TOOL_OUTPUT_CHARS=12000
WEB_SEARCH_ENABLED=true
