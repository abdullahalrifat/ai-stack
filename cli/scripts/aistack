#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "${script_path}" ]]; do
  script_dir="$(cd -- "$(dirname -- "${script_path}")" && pwd)"
  link_target="$(readlink "${script_path}")"
  if [[ "${link_target}" = /* ]]; then
    script_path="${link_target}"
  else
    script_path="${script_dir}/${link_target}"
  fi
done
script_dir="$(cd -- "$(dirname -- "${script_path}")" && pwd)"
cli_dir="$(cd -- "${script_dir}/.." && pwd)"
checkout_dir="$(cd -- "${cli_dir}/.." && pwd)"

export PYTHONPATH="${cli_dir}/src${PYTHONPATH:+:${PYTHONPATH}}"
if [[ -z "${AISTACK_ENV_FILE:-}" && -f "${cli_dir}/.env" ]]; then
  export AISTACK_ENV_FILE="${cli_dir}/.env"
elif [[ -z "${AISTACK_ENV_FILE:-}" && -f "${checkout_dir}/.env" ]]; then
  export AISTACK_ENV_FILE="${checkout_dir}/.env"
fi

exec python3 -m aistack_cli "$@"
