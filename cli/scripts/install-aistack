#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
script_dir="$(cd -- "$(dirname -- "${script_path}")" && pwd)"
source_path="${script_dir}/aistack"
cli_dir="$(cd -- "${script_dir}/.." && pwd)"
legacy_source_path="$(cd -- "${cli_dir}/.." && pwd)/scripts/aistack"
install_dir="${AISTACK_INSTALL_DIR:-${HOME}/.local/bin}"
target_path="${install_dir}/aistack"

if [[ "${1:-}" == "--uninstall" ]]; then
  if [[ ! -L "${target_path}" ]]; then
    echo "Refusing to remove ${target_path}: it is not an ai-stack symlink." >&2
    exit 1
  fi
  linked_path="$(readlink "${target_path}")"
  if [[ "${linked_path}" != "${source_path}" && "${linked_path}" != "${legacy_source_path}" ]]; then
    echo "Refusing to remove ${target_path}: it points to ${linked_path}." >&2
    exit 1
  fi
  rm "${target_path}"
  echo "Removed ${target_path}"
  exit 0
fi

if [[ "$#" -ne 0 ]]; then
  echo "Usage: ./cli/scripts/install-aistack [--uninstall]" >&2
  exit 2
fi

mkdir -p "${install_dir}"
if [[ -e "${target_path}" || -L "${target_path}" ]]; then
  if [[ -L "${target_path}" && "$(readlink "${target_path}")" == "${source_path}" ]]; then
    echo "Already installed: ${target_path}"
    exit 0
  fi
  if [[ -L "${target_path}" && "$(readlink "${target_path}")" == "${legacy_source_path}" ]]; then
    rm "${target_path}"
    ln -s "${source_path}" "${target_path}"
    echo "Updated ${target_path}"
    exit 0
  fi
  echo "Refusing to overwrite existing path: ${target_path}" >&2
  exit 1
fi

ln -s "${source_path}" "${target_path}"
echo "Installed ${target_path}"
if [[ ":${PATH}:" != *":${install_dir}:"* ]]; then
  echo "Add ${install_dir} to PATH, then start a new terminal." >&2
fi