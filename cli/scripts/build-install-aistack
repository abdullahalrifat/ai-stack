#!/usr/bin/env bash
set -euo pipefail

# Build the CLI package as a wheel and install it into a target Python
# environment.
#
# The repository-local symlink installer (./cli/scripts/install-aistack) is
# the recommended way to run the CLI against a checkout. This script is for
# packaging-style installs: it produces a wheel under cli/dist and installs
# that wheel, so the console entry point and metadata match what CI builds.

script_path="${BASH_SOURCE[0]}"
script_dir="$(cd -- "$(dirname -- "${script_path}")" && pwd)"
cli_dir="$(cd -- "${script_dir}/.." && pwd)"
checkout_dir="$(cd -- "${cli_dir}/.." && pwd)"

dist_dir="${AISTACK_CLI_DIST_DIR:-${cli_dir}/dist}"
python_bin="${AISTACK_CLI_PYTHON:-${checkout_dir}/.venv/bin/python}"

usage() {
  cat <<'EOF'
Usage: ./cli/scripts/build-install-aistack [--help]

Builds the CLI as a wheel and installs it into the target environment.

Environment:
  AISTACK_CLI_PYTHON    Python interpreter of the target venv
                        (default: checkout/.venv/bin/python)
  AISTACK_CLI_DIST_DIR  Where to write the built wheel (default: cli/dist)
EOF
}

if [[ "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi
if [[ "$#" -ne 0 ]]; then
  usage >&2
  exit 2
fi

if [[ ! -x "${python_bin}" ]]; then
  echo "No interpreter at ${python_bin}; set AISTACK_CLI_PYTHON." >&2
  exit 1
fi

mkdir -p "${dist_dir}"
"${python_bin}" -m pip wheel --no-deps "${cli_dir}" --wheel-dir "${dist_dir}"

wheel="$(ls -1t "${dist_dir}"/aistack_cli-*.whl 2>/dev/null | head -n 1)"
if [[ -z "${wheel}" ]]; then
  echo "No wheel produced under ${dist_dir}." >&2
  exit 1
fi

"${python_bin}" -m pip install --force-reinstall "${wheel}"

echo
echo "Installed: ${wheel}"
bin_dir="$(cd -- "$(dirname -- "${python_bin}")" && pwd)"
if [[ -x "${bin_dir}/aistack" ]]; then
  "${bin_dir}/aistack" --version
  echo "Run it with: ${bin_dir}/aistack"
else
  "${python_bin}" -m aistack_cli --version
  echo "Run it with: ${python_bin} -m aistack_cli"
fi
