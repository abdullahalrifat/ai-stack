# Conservative profile for a CPU-only 16 GB RAM home server.
# Copy the required secrets from .env.example, then merge these values into .env.
# This profile favors stability over throughput.

OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_CONTEXT_LENGTH=16384

# Keep the 8B coding model as the normal default; use 14B reasoning/vision only
# for deliberate escalations because those models are substantially heavier.
DEFAULT_MODEL=coder
FAST_MODEL=quick
ROUTER_MODEL=quick
ROUTER_ESCALATION_MODEL=coder
AGENT_REASONING_MODEL=qwen3-14b
CHANGE_REVIEW_MODEL=reasoning

MAX_CONCURRENT_AGENT_RUNS=1
MAX_CONCURRENT_LLM_CALLS=1
MAX_PARALLEL_EXPERTS=1
EXPERT_DISPATCH_ENABLED=false

CONTEXT_TOKEN_LIMIT=16384
CONTEXT_OUTPUT_RESERVE_TOKENS=3072
OPENAI_INPUT_MAX_CHARS=10000
MAX_TOOL_OUTPUT_CHARS=12000

# Local/off-grid mode.
WEB_SEARCH_ENABLED=false
ANTHROPIC_MODEL=
ANTHROPIC_API_KEY=
HF_MODEL=
HF_INFERENCE_BASE_URL=
HF_API_KEY=

# Keep the model set small enough for the host. Add 14B/vision models only when
# you have enough RAM/swap and accept slower CPU inference.
OLLAMA_MODELS=qwen3:4b-instruct qwen3:8b nomic-embed-text
