# Conservative profile for a CPU-only 16 GB RAM home server.
# Copy the required secrets from .env.example, then merge these values into .env.
# This profile favors stability over throughput.

OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_CONTEXT_LENGTH=16384

# Keep the 8B model as the quality tier; use it for deliberate escalations
# because the OptiPlex profile does not keep larger models resident.
DEFAULT_MODEL=qwen3:4b
FAST_MODEL=qwen3:4b
ROUTER_MODEL=qwen3:4b
ROUTER_ESCALATION_MODEL=qwen3:4b
AGENT_REASONING_MODEL=qwen3:4b
CHANGE_REVIEW_MODEL=qwen3:4b

MAX_CONCURRENT_AGENT_RUNS=1
MAX_CONCURRENT_LLM_CALLS=1
MAX_PARALLEL_EXPERTS=1
EXPERT_DISPATCH_ENABLED=false

CONTEXT_TOKEN_LIMIT=16384
CONTEXT_OUTPUT_RESERVE_TOKENS=3072
OPENAI_INPUT_MAX_CHARS=10000
MAX_TOOL_OUTPUT_CHARS=12000

# Local/off-grid mode.
WEB_SEARCH_ENABLED=false
ANTHROPIC_MODEL=
ANTHROPIC_API_KEY=
HF_MODEL=
HF_INFERENCE_BASE_URL=
HF_API_KEY=

# Keep the model set small enough for the host; this profile uses only 4B/8B local models.
OLLAMA_MODELS=qwen3:4b