# Copy to .env and replace every value before starting the stack.
POSTGRES_DB=ai_stack
POSTGRES_USER=ai_stack
POSTGRES_PASSWORD=change-this-to-a-long-random-password

# Use different long random values for these two keys.
LITELLM_MASTER_KEY=sk-change-this-to-a-long-random-key

# Optional remote execution models. Leave every variable blank to remain
# completely local. A provider is enabled only when all of its variables are set.
# Claude is accessed through Anthropic's API; Claude weights cannot be deployed
# to Hugging Face.
ANTHROPIC_MODEL=
ANTHROPIC_API_KEY=

# OpenAI-compatible Hugging Face Inference Endpoint for an open-weight model.
# Example base URL: https://<endpoint>.endpoints.huggingface.cloud/v1
HF_MODEL=
HF_INFERENCE_BASE_URL=
HF_API_KEY=
AGENT_API_KEY=agent-change-this-to-a-long-random-key
RUNNER_API_KEY=runner-change-this-to-a-different-long-random-key
PIPELINES_API_KEY=change-this-to-a-long-random-key
SEARXNG_SECRET=change-this-to-a-long-random-key

# Absolute host directory exposed to the coding agent as /workspace.
WORKSPACE_PATH=/mnt/work/code
DEFAULT_WORKSPACE_DIR=/workspace

# CPU-mode defaults for a 3-vCPU/14-GB VM: 1.7B default with 4B reserved for heavy work.
# Resource limits protect the VM, but response quality is not intentionally
# degraded by tiny completion caps. Output budgets below are task budgets, not
# arbitrary truncation; increase them when the task genuinely needs more output.
# Keep only one generation model resident; both local generation models remain installed.
# Keep the full 8K context unless the deployment has a measured reason to reduce it.
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=5m
OLLAMA_CONTEXT_LENGTH=8192
INFERENCE_ENABLED=false
INFERENCE_BASE_URL=http://jarvis-inference:8080/v1
INFERENCE_API_KEY=

DEFAULT_MODEL=qwen3:1.7b
FAST_MODEL=qwen3:1.7b
ROUTER_MODEL=qwen3:1.7b
ROUTER_MAX_COMPLETION_TOKENS=768
ROUTER_TIMEOUT_SECONDS=120
RESEARCH_MODEL=qwen3:1.7b
FINANCE_MODEL=qwen3:4b
LLM_TIMEOUT_SECONDS=180
LLM_MAX_COMPLETION_TOKENS=1536
ANALYSIS_SYNTHESIS_MODEL=qwen3:4b
ANALYSIS_SYNTHESIS_MAX_TOKENS=1536
ANALYSIS_SYNTHESIS_TIMEOUT_SECONDS=240
AGENT_REASONING_MODEL=qwen3:4b
AGENT_MODEL_ESCALATIONS=1
CHANGE_REVIEW_MODEL=qwen3:4b
CHANGE_REVIEW_MODEL_ENABLED=true
EXPERT_DISPATCH_ENABLED=false
EXPERT_DISPATCH_MODEL=qwen3:4b
MAX_PARALLEL_EXPERTS=1
EXPERT_MAX_COMPLETION_TOKENS=512
EXPERT_DISPATCH_TIMEOUT_SECONDS=600
EXPERT_FINDINGS_CONTEXT_CHARS=1600
PLANNER_MAX_COMPLETION_TOKENS=256
REPLAN_MAX_COMPLETION_TOKENS=384
REPLAN_FAIL_STREAK=4
REPLAN_STUCK_STEPS=8
REPLAN_MAX_RETRIES=1
FINANCE_MAX_COMPLETION_TOKENS=1536
FINANCE_LLM_TIMEOUT_SECONDS=300
MAX_TOOL_OUTPUT_CHARS=10000
CONTEXT_TOKEN_LIMIT=8192
CONTEXT_OUTPUT_RESERVE_TOKENS=1536
MAX_AGENT_STEPS=40
MAX_PARALLEL_TOOL_CALLS=2
MAX_EMPTY_MODEL_TURNS=3
MAX_EMPTY_SEARCH_RESULTS=3
MAX_UNPRODUCTIVE_TOOL_CALLS=3
TOOL_RESULT_SUMMARY_CHARS=4000
TOOL_RESULT_SUMMARY_ITEMS=4
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF_SECONDS=2
MAX_CONCURRENT_AGENT_RUNS=1
MAX_CONCURRENT_LLM_CALLS=1
RUN_WORKER_LEASE_SECONDS=60
RUNNER_JOB_LEASE_SECONDS=10
COMMAND_TIMEOUT_SECONDS=300
WEB_SEARCH_ENABLED=true
WEB_SEARCH_URL=http://searxng:8080/search
WEB_SEARCH_TIMEOUT_SECONDS=15
WEB_FETCH_MAX_BYTES=8000000
IMAGE_GENERATION_URL=
IMAGE_GENERATION_TIMEOUT_SECONDS=180

WORKSPACE_ROOTS=
ALLOWED_COMMANDS=git,ls,cat,pytest,python,python3,npm,node,make,grep,find,mypy,ruff,black,flake8
EDIT_ALLOWED_PATHS=
COMMAND_ALLOWLIST=
RUN_COMMANDS_ALLOW_NETWORK=false

CONTEXT_COMPACT_THRESHOLD_TOKENS=6000
CONTEXT_COMPACT_KEEP_RECENT=4
MEMORY_ENABLED=true
MEMORY_FOR_CODE_RUNS=false
GENERATED_MEMORY_ENABLED=false
OPENAI_INPUT_MAX_CHARS=12000
OLLAMA_EMBED_MAX_CHARS=4000
MEMORY_CONTEXT_TOKENS=1200
DOCUMENT_MAX_BYTES=10000000
MODEL_LIST_CACHE_SECONDS=300

RUNNER_CPU_SECONDS=300
RUNNER_MEMORY_MB=2048
RUNNER_MAX_OPEN_FILES=256
RUNNER_ENABLE_NETNS=true
RUN_EVENT_BATCH_CHARS=2048
RUN_EVENT_BATCH_SECONDS=0.50

AGENT_MEMORY_LIMIT=2g
AGENT_CPUS=0.50

# HARD VM SURVIVAL GUARDRAILS: 3 CPU cores / 14 GB total.
# These are Docker cgroup limits, not just application preferences.
OLLAMA_CPUS=1.10
OLLAMA_MEMORY_LIMIT=6g
RUNNER_CPUS=0.25
RUNNER_MEMORY_LIMIT=768m
ALLOW_INSECURE_NO_AUTH=false

ARTIFACT_ROOT=/tmp/jarvis-artifacts

# Models automatically pulled before LiteLLM starts.
OLLAMA_MODELS=qwen3:1.7b qwen3:4b nomic-embed-text

TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0

# Adaptive heterogeneous role routing.
QUALITY_MODEL_ROUTES=[{"model":"qwen3:1.7b","provider":"openai","quality":0.70,"tool_success":0.75,"structured_success":0.75,"latency":0.10,"cost":0.03,"roles":["chat","routing","research"]},{"model":"qwen3:4b","provider":"openai","quality":0.90,"tool_success":0.90,"structured_success":0.88,"latency":0.45,"cost":0.10,"roles":["implementation","coding","verification","risk","reasoning"]}]
