# Copy to .env and replace every value before starting the stack.
POSTGRES_DB=ai_stack
POSTGRES_USER=ai_stack
POSTGRES_PASSWORD=change-this-to-a-long-random-password

# Use different long random values for these two keys.
LITELLM_MASTER_KEY=sk-change-this-to-a-long-random-key

# Optional remote execution models. Leave every variable blank to remain
# completely local. A provider is enabled only when all of its variables are set.
# Claude is accessed through Anthropic's API; Claude weights cannot be deployed
# to Hugging Face.
ANTHROPIC_MODEL=
ANTHROPIC_API_KEY=

# OpenAI-compatible Hugging Face Inference Endpoint for an open-weight model.
# Example base URL: https://<endpoint>.endpoints.huggingface.cloud/v1
HF_MODEL=
HF_INFERENCE_BASE_URL=
HF_API_KEY=
# Read-only fine-grained token with Contents access to the private jarvis-core
# repository. GitHub Actions stores the same value as CROSS_REPO_TOKEN.
# It is mounted into Docker builds as a BuildKit secret and never copied into
# the resulting image.
CROSS_REPO_TOKEN=

AGENT_API_KEY=agent-change-this-to-a-long-random-key
RUNNER_API_KEY=runner-change-this-to-a-different-long-random-key
PIPELINES_API_KEY=change-this-to-a-long-random-key
SEARXNG_SECRET=change-this-to-a-long-random-key

# Absolute host directory exposed to the coding agent as /workspace.
# Mount only repositories the agent is allowed to inspect or edit.
WORKSPACE_PATH=/mnt/work/code
# Repository used when the client does not explicitly select a workspace.
# This is an in-container path under WORKSPACE_DIR, not a host path.
DEFAULT_WORKSPACE_DIR=/workspace

# CPU-mode defaults: 8B for coding, 4B for routine chat and research.
OLLAMA_MAX_LOADED_MODELS=3
OLLAMA_NUM_PARALLEL=1
# Model context window in tokens; keep in sync with the num_ctx entries in
# litellm/config.yaml. Lower it on memory-constrained hosts.
OLLAMA_CONTEXT_LENGTH=32768
DEFAULT_MODEL=coder
FAST_MODEL=quick
ROUTER_MODEL=quick
ROUTER_ESCALATION_MODEL=coder
ROUTER_MAX_COMPLETION_TOKENS=1536
ROUTER_TIMEOUT_SECONDS=240
ROUTER_ESCALATION_TIMEOUT_SECONDS=480
RESEARCH_MODEL=quick
FINANCE_MODEL=coder
# Bound a local model turn so a long generation does not block the queue.
LLM_TIMEOUT_SECONDS=600
LLM_MAX_COMPLETION_TOKENS=3072
ANALYSIS_SYNTHESIS_MODEL=qwen3-14b
ANALYSIS_SYNTHESIS_MAX_TOKENS=2048
ANALYSIS_SYNTHESIS_TIMEOUT_SECONDS=600
AGENT_REASONING_MODEL=qwen3-14b
AGENT_MODEL_ESCALATIONS=3
CHANGE_REVIEW_MODEL=reasoning
CHANGE_REVIEW_MODEL_ENABLED=true
# Multi-expert dispatch: complex/multi-workflow auto-routed runs launch several
# bounded expert analyses (architecture/implementation/verification/risk) in
# parallel and merge their structured findings into the evidence ledger.
EXPERT_DISPATCH_ENABLED=true
EXPERT_DISPATCH_MODEL=qwen3-14b
MAX_PARALLEL_EXPERTS=4
EXPERT_MAX_COMPLETION_TOKENS=1024
EXPERT_DISPATCH_TIMEOUT_SECONDS=600
EXPERT_FINDINGS_CONTEXT_CHARS=2400
# Planner JSON is advisory and intentionally short; failed parsing falls back
# to no plan instead of failing a run.
PLANNER_MAX_COMPLETION_TOKENS=384
# Re-planning policy: revise the plan after this many consecutive failing
# steps, or this many steps with no new useful evidence; at most this many
# revisions before normal recovery behavior takes over.
REPLAN_MAX_COMPLETION_TOKENS=512
REPLAN_FAIL_STREAK=5
REPLAN_STUCK_STEPS=12
REPLAN_MAX_RETRIES=3
# Finance uses a larger budget for evidence plus forward-looking scenarios.
FINANCE_MAX_COMPLETION_TOKENS=1536
FINANCE_LLM_TIMEOUT_SECONDS=600
MAX_TOOL_OUTPUT_CHARS=16000
CONTEXT_TOKEN_LIMIT=32768
CONTEXT_OUTPUT_RESERVE_TOKENS=4096
MAX_AGENT_STEPS=80
# Independent read-only tool calls in one model turn run concurrently instead
# of sequentially. Write tools are never parallelized.
MAX_PARALLEL_TOOL_CALLS=6
# Return a partial evidence-based answer after this many empty model turns.
MAX_EMPTY_MODEL_TURNS=5
# Stop after this many consecutive empty repository content searches.
MAX_EMPTY_SEARCH_RESULTS=5
MAX_UNPRODUCTIVE_TOOL_CALLS=5
# Model-visible budget for a single tool result once structured summarization
# kicks in, and how many head/tail items a list-shaped result keeps.
TOOL_RESULT_SUMMARY_CHARS=6000
TOOL_RESULT_SUMMARY_ITEMS=6
# Transient gateway errors (connection refused while Ollama reloads a model,
# 5xx, rate limits) are retried with exponential backoff before a run fails.
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_SECONDS=2
# Keep this at one for a CPU-hosted Ollama model. Raise only with adequate GPU capacity.
MAX_CONCURRENT_AGENT_RUNS=2
MAX_CONCURRENT_LLM_CALLS=1
# How long a worker holds a run lease while the agent service is down, before
# another worker may take over and reconcile the run.
RUN_WORKER_LEASE_SECONDS=60
# How often the agent-runner polls for new jobs (seconds).
RUNNER_JOB_LEASE_SECONDS=10
COMMAND_TIMEOUT_SECONDS=300
WEB_SEARCH_ENABLED=true
WEB_SEARCH_URL=http://searxng:8080/search
WEB_SEARCH_TIMEOUT_SECONDS=15
# Maximum downloaded HTML/PDF size for web_fetch (8 MB default).
WEB_FETCH_MAX_BYTES=8000000

# Optional Automatic1111/Forge image backend, for example:
# IMAGE_GENERATION_URL=http://host.docker.internal:7860
IMAGE_GENERATION_URL=
IMAGE_GENERATION_TIMEOUT_SECONDS=180

# ---------------------------------------------------------------------------
# Optional -- all of the following have working defaults in
# docker-compose.yaml and can be left unset.
# ---------------------------------------------------------------------------

# Model id the agent advertises at /v1/models (must match the model_ids entry
# under OPENAI_API_CONFIGS for the "agent" connection in Open WebUI).
# AGENT_MODEL_ID=orchestrator

# Extra in-container paths, beyond /workspace, the agent may be pointed at
# via a request's `workspace` field. Each path must also be mounted as a
# volume on the `agents` service in docker-compose.yaml. Comma-separated.
# WORKSPACE_ROOTS=/extra-workspace,/another-repo

# Executables the run_command tool may invoke (no shell metacharacters are
# ever permitted, regardless of this list). Comma-separated.
# ALLOWED_COMMANDS=git,ls,cat,pytest,python,python3,npm,node,make,grep,find,mypy,ruff,black,flake8

# Tier 2 scoped permissions. When non-empty, write tools are limited to these
# workspace-relative directories for write-capable runs (scope becomes
# "scoped-write"); empty keeps the legacy full-write scope. COMMAND_ALLOWLIST
# optionally narrows ALLOWED_COMMANDS further. RUN_COMMANDS_ALLOW_NETWORK
# moves command execution to the runner's "network" tier; keep it false to
# stay on the internal network.
# EDIT_ALLOWED_PATHS=src,server/app
# COMMAND_ALLOWLIST=pytest,ruff,python3
# RUN_COMMANDS_ALLOW_NETWORK=false

# Compact only near the context limit, rather than after a fixed number of tools.
CONTEXT_COMPACT_THRESHOLD_TOKENS=24000
# Old step-count compaction trigger, kept for backwards compatibility; no
# longer used when CONTEXT_COMPACT_THRESHOLD_TOKENS is configured.
# CONTEXT_COMPACT_EVERY_STEPS=6
# How many most-recent transcript messages stay verbatim when compacting.
CONTEXT_COMPACT_KEEP_RECENT=4
# Global memory switch (embeddings + retrieval). MEMORY_FOR_CODE_RUNS scopes
# it to routine Code/Quick turns.
# MEMORY_ENABLED=true
# Bound Open WebUI/Continue input before the agent adds tools and its own
# instructions, preventing an 8K Ollama context overflow.
OPENAI_INPUT_MAX_CHARS=16000
# Disable expensive embeddings for routine Code/Quick turns. Enable this only
# when you intentionally want repository-scoped RAG on those profiles.
MEMORY_FOR_CODE_RUNS=false
# Disabled by default: feeding model answers back into retrieval can reinforce
# unsupported claims. Enable only when that tradeoff is intentional.
GENERATED_MEMORY_ENABLED=false
OLLAMA_EMBED_MAX_CHARS=6000
# Maximum retrieved document context supplied to a model turn.
MEMORY_CONTEXT_TOKENS=2400
# Maximum size of each uploaded PDF/DOCX/XLSX/text document (10 MB default).
DOCUMENT_MAX_BYTES=10000000

# How long (seconds) the agent caches the model list from LiteLLM before
# re-checking it.
# MODEL_LIST_CACHE_SECONDS=300

# Per-command limits inside the isolated agent container.
RUNNER_CPU_SECONDS=300
RUNNER_MEMORY_MB=4096
# RUNNER_MAX_OPEN_FILES=256
# Run "isolated"-tier commands in a private network namespace when the host's
# unshare supports it. The agent-runner drops all capabilities, so the
# internal Docker network normally remains the boundary.
# RUNNER_ENABLE_NETNS=true

# Streamed output is coalesced before durable persistence / Redis publication.
# RUN_EVENT_BATCH_CHARS=2048
# RUN_EVENT_BATCH_SECONDS=0.50

# Overall agent-container resource limits.
# AGENT_MEMORY_LIMIT=8g
# AGENT_CPUS=4

# Set to true only for isolated local development without an AGENT_API_KEY.
# Never enable this on anything reachable outside your own machine.
# ALLOW_INSECURE_NO_AUTH=false

# ---------------------------------------------------------------------------
# Internal service wiring -- normally derived from the compose topology and
# only overridden for custom deployments (see docker-compose.yaml):
# WORKSPACE_DIR=/workspace            in-container path of the bind mount
# SANDBOX_ROOT=/sandboxes             isolated command sandbox directory
# POSTGRES_URL=postgresql://...       runs/events store
# REDIS_URL=redis://redis:6379/0      event publication bus
# RUNNER_URL=http://agent-runner:8001 isolated command runner endpoint
# ---------------------------------------------------------------------------

# Persistent content-addressed tool artifacts (mount this path in production)
ARTIFACT_ROOT=/tmp/jarvis-artifacts

# Optional capability-aware model profiles, encoded as one JSON object.
# JARVIS_MODEL_PROFILES_JSON={"coder":{"model":"coder","priority":10,"capabilities":{"tool_calling":true,"structured_output":true}}}

# Optional fixed MCP stdio commands. Never configure untrusted executables.
# JARVIS_MCP_SERVERS_JSON={"filesystem":["python","-m","your_mcp_server"]}
