# Copy to .env and replace every value before starting the stack.
POSTGRES_DB=ai_stack
POSTGRES_USER=ai_stack
POSTGRES_PASSWORD=change-this-to-a-long-random-password

# Use different long random values for these two keys.
LITELLM_MASTER_KEY=sk-change-this-to-a-long-random-key
AGENT_API_KEY=agent-change-this-to-a-long-random-key
PIPELINES_API_KEY=change-this-to-a-long-random-key
SEARXNG_SECRET=change-this-to-a-long-random-key

# Absolute host directory exposed to the coding agent as /workspace.
# Mount only repositories the agent is allowed to inspect or edit.
WORKSPACE_PATH=/mnt/work/code

DEFAULT_MODEL=coder
MAX_AGENT_STEPS=12
COMMAND_TIMEOUT_SECONDS=120
WEB_SEARCH_ENABLED=true

# ---------------------------------------------------------------------------
# Optional -- all of the following have working defaults in
# docker-compose.yaml and can be left unset.
# ---------------------------------------------------------------------------

# Model id the agent advertises at /v1/models (must match the model_ids entry
# under OPENAI_API_CONFIGS for the "agent/" connection in Open WebUI).
# AGENT_MODEL_ID=coding-agent

# Extra in-container paths, beyond /workspace, the agent may be pointed at
# via a request's `workspace` field. Each path must also be mounted as a
# volume on the `agents` service in docker-compose.yaml. Comma-separated.
# WORKSPACE_ROOTS=/extra-workspace,/another-repo

# Executables the run_command tool may invoke (no shell metacharacters are
# ever permitted, regardless of this list). Comma-separated.
# ALLOWED_COMMANDS=git,ls,cat,pytest,python,python3,npm,node,make,grep,find,mypy,ruff,black,flake8

# How many tool-call steps the executor takes before summarizing older
# transcript entries to keep context bounded on long-running tasks.
# CONTEXT_COMPACT_EVERY_STEPS=6

# How long (seconds) the agent caches the model list from LiteLLM before
# re-checking it.
# MODEL_LIST_CACHE_SECONDS=300

# Per-command limits inside the isolated agent container.
# RUNNER_CPU_SECONDS=90
# RUNNER_MEMORY_MB=2048
# RUNNER_MAX_OPEN_FILES=256

# Streamed output is coalesced before durable persistence / Redis publication.
# RUN_EVENT_BATCH_CHARS=256
# RUN_EVENT_BATCH_SECONDS=0.10

# Overall agent-container resource limits.
# AGENT_MEMORY_LIMIT=4g
# AGENT_CPUS=4

# Set to true only for isolated local development without an AGENT_API_KEY.
# Never enable this on anything reachable outside your own machine.
# ALLOW_INSECURE_NO_AUTH=false
